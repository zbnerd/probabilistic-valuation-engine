{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::maple-expectation/runs/*",
        "arn:aws:s3:::maple-expectation/calculator/runs/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:HeadBucket"],
      "Resource": ["arn:aws:s3:::maple-expectation"]
    }
  ]
}
