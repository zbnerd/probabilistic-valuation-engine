[Unit]
Description=Maple Pipeline - Calculator (port 8082)
Documentation=https://github.com/zbnerd/probabilistic-valuation-engine
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=maple
Group=maple
WorkingDirectory=/opt/maple
EnvironmentFile=/opt/maple/.env
EnvironmentFile=/opt/maple/.env.calculator
ExecStart=/usr/bin/java -Xms512m -Xmx1g -jar /opt/maple/module-calculator/build/libs/module-calculator-0.0.1-SNAPSHOT.jar
Restart=on-failure
RestartSec=5
SuccessExitStatus=143

StandardOutput=append:/var/log/maple/calculator.log
StandardError=append:/var/log/maple/calculator-error.log

NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
