[Unit]
Description=Maple Pipeline - External API (port 8081)
Documentation=https://github.com/zbnerd/probabilistic-valuation-engine
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=maple
Group=maple
WorkingDirectory=/opt/maple
EnvironmentFile=/opt/maple/.env
EnvironmentFile=/opt/maple/.env.ext-api
ExecStart=/usr/bin/java -Xms512m -Xmx1g -jar /opt/maple/module-external-api/build/libs/module-external-api-0.0.1-SNAPSHOT.jar
Restart=on-failure
RestartSec=5
SuccessExitStatus=143

StandardOutput=append:/var/log/maple/external-api.log
StandardError=append:/var/log/maple/external-api-error.log

NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
